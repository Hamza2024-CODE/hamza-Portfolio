Options +FollowSymLinks -Indexes
RewriteEngine On

# Disable Apache's automatic physical trailing slash redirects for directories
DirectorySlash Off

# Pass-through for real existing files or directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Explicit Service Worker, Manifest, and Assets
RewriteRule ^sw\.js$ public/sw.js [L]
RewriteRule ^manifest\.json$ public/manifest.php [L]
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Clean URL Routing
RewriteRule ^admin/?$ public/admin.php [L,QSA]
RewriteRule ^admin\.php$ public/admin.php [L,QSA]
RewriteRule ^about/?$ public/about.php [L,QSA]
RewriteRule ^projects/?$ public/projects/projects.php [L,QSA]
RewriteRule ^articles/?$ public/articles/articles.php [L,QSA] 
RewriteRule ^articles/([^/]+)/?$ public/articles/post.php?slug=$1 [L,QSA]
RewriteRule ^tools/?$ public/tools/index.php [L,QSA]
RewriteRule ^tools/php_converter/?$ public/tools/php_converter.php [L,QSA]
RewriteRule ^tools/php_writer/?$ public/tools/php_writer.php [L,QSA]
RewriteRule ^tools/php_syllabus/?$ public/tools/php_syllabus.php [L,QSA]
RewriteRule ^tools/omr_evaluator/?$ public/tools/omr_evaluator.php [L,QSA]
RewriteRule ^tools/(.*)$ public/tools/$1 [L,QSA]

# Route root URL to public/index.php
RewriteRule ^$ public/index.php [L]

# General fallback to public/index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.php?/$1 [L,QSA]
